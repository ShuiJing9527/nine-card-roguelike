    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u672C\u7248\u6D4B\u8BD5\u8FB9\u754C\n\u2022 \u4E2D\u6BD2\u6BCF\u5C422\u70B9\u3001\u707C\u4F245\u70B9\u5747\u4E3A\u672C\u8F6E\u6D4B\u8BD5\u53C2\u6570\u3002\n\u2022
    \u6D41\u8840\u4EC5\u8BB0\u5F55\u5C42\u6570\uFF1A\u6301\u7EED/\u8870\u51CF/\u4F4D\u79FB\u4F24\u5BB3\u7CFB\u6570\u5F85\u5B9A\u3002\n\u2022
    \u62D2\u654C\u67B6\u52BF\u539F\u751F\u8BCD\u6761\u5F85\u5B9A\uFF0C\u4E0D\u4EA7\u751F\u8BCD\u6761\u6536\u76CA\u3002\n\u2022
    \u6311\u7A7A\u523A\u7B2C\u4E8C\u6BB5\u9ED8\u8BA4\u4F7F\u7528\u7B2C13\u9875165%\u6D4B\u8BD5\u503C\uFF1B\u4E0E\u5176\u4ED6\u9875150%\u51B2\u7A81\uFF0C\u53EF\u5173\u95ED\u7B2C\u4E8C\u6BB5\u6D4B\u8BD5\u3002\u78B0\u649E\u843D\u70B9/\u53E6\u4E00\u4E2A\u654C\u4EBA\u4E0D\u6A21\u62DF\u3002\n\u2022
    \u730E\u5F13\u5373\u65F6\u518D\u52A8\u89E6\u53D1\u6761\u4EF6\u4E0E\u5176\u4F59\u6B66\u5668\u56FA\u6709\u80FD\u529B\u5F85\u5B9A\uFF0C\u672A\u542F\u7528\u3002\n\u2022
    \u540C\u540D\u56FA\u5B9A\u5C5E\u6027\u589E\u76CA\u3001\u62DB\u67B6\u3001\u53CD\u51FB\u59FF\u6001\u7684\u91CD\u590D\u5E45\u5EA6\u672A\u5B9A\uFF1A\u6709\u6548\u671F\u95F4\u62D2\u7EDD\u91CD\u590D\u65BD\u653E\uFF0C\u907F\u514D\u81EA\u884C\u51B3\u5B9A\u53E0\u52A0\u3002\n\u2022
    \u81F4\u6B7B\u53CD\u4F24\u5148\u540E\u5F85\u5B9A\uFF1A\u9ED8\u8BA4\u6D4B\u8BD5\u5012\u4E0B\u540E\u4ECD\u8FD4\u8FD8\u5DF2\u627F\u53D7\u4F24\u5BB3\uFF0C\u53EF\u5728Rules\u4E2D\u5173\u95ED\u3002\n\u2022
    \u6CBB\u7597\u6EA2\u51FA\u5F85\u5B9A\uFF1ADemo\u4EC5\u6062\u590D\u81F3\u6700\u5927\u751F\u547D\uFF0C\u6EA2\u51FA\u4E0D\u8F6C\u6362\u5176\u4ED6\u6536\u76CA\u3002\n\u2022
    \u591A\u79CD\u62A4\u76FE\u6C60\u3001\u955C\u50CF\u3001\u6269\u5C55\u8BCD\u6761\u3001\u5F3A\u63A7\u5361\u4E0E\u5947\u7269\u4E0D\u5728\u672C\u7248\u5361\u6C60\uFF1B\u6570\u636E\u7ED3\u6784\u4FDD\u7559\u63A5\u53E3\u3002"
