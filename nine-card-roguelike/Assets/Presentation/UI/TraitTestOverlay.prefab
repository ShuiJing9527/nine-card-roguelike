  m_Material: {fileID: 0}
  m_Color: {r: 0.89, g: 0.93, b: 0.98, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 1e9b77d6c37aff24db6e1dabfc56b543, type: 2}
    m_FontSize: 18
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u8FFD\u51FB\u3014\u653B\u52BF\u3015\n\u5DF2\u5B9E\u73B0 \xB7 \u53EF\u914D\u7F6E\n\n\u8FFD\u52A0
    \u5F53\u524D\u8FDE\u9501\u6570 \u4E2A\u540C\u7C7B\u578B\u76F4\u63A5\u653B\u51FB\u6BB5\u3002\u6BCF\u6BB5\u4EE5\u672C\u6B21\u4E3B\u6280\u80FD\u539F\u751F\u603B\u7CFB\u6570\u768415%\u4E3A\u57FA\u7840\uFF0C\u518D\u6309\u672C\u5361\u5B9E\u96451\uFF5E5\u53F7\u4F4D\u4F9D\u6B21\u4FDD\u755990%\u300180%\u300170%\u300160%\u300150%\u3002\n\n\u8BA1\u7B97\u8BF4\u660E\uFF1A\u539F\u751F\u603B\u7CFB\u6570\u4E3A\u4E3B\u6280\u80FD\u9884\u5B9A\u76F4\u63A5\u653B\u51FB\u6BB5\u7CFB\u6570\u4E4B\u548C\uFF1B\u7FA4\u653B\u4EC5\u8BA1\u4E00\u540D\u76EE\u6807\u7684\u4E00\u5957\u6BB5\u6570\uFF0C\u4E0D\u4E58\u654C\u4EBA\u6570\u3002\u6982\u7387\u7EED\u5C04\u53EA\u8BA1\u9996\u6B21\u5FC5\u5B9A\u6BB5\uFF1B\u6311\u98DE\u843D\u5730\u7B49\u4E8C\u6B21\u4F24\u5BB3\u3001\u8BCD\u6761\u52A0\u503C\u548C\u6D88\u8017\u62A4\u76FE\u8F6C\u4F24\u4E0D\u8BA1\u5165\u57FA\u51C6\u3002\u968F\u673A\u5F39\u5C04\u6309\u5408\u6CD5\u76EE\u6807\u4E0B\u9884\u5B9A\u7684\u539F\u751F\u6BB5\u5408\u8BA1\u3002\u8FFD\u52A0\u6B21\u6570\u53EF\u968F\u5F53\u524D\u8FDE\u9501\u6570\u63D0\u9AD8\uFF0C\u69FD\u4F4D\u6BD4\u4F8B\u4E0D\u53D8\uFF1B\u4E0D\u590D\u5236\u989D\u5916\u72B6\u6001\u3001\u63A7\u5236\u3001\u6574\u5957\u7FA4\u653B\u6216\u518D\u6B21\u751F\u6210\u8FFD\u51FB/\u955C\u50CF\u3002\n\n\u5F53\u524D\u8FDE\u9501\u9ED8\u8BA4\u7B49\u4E8E\u5361\u7247\u6392\u8C31\u69FD\u4F4D1\uFF5E5\uFF1B\u540C\u540D\u8BCD\u6761\u5206\u522B\u8BA1\u7B97\u3002\u5339\u914D\u68C0\u67E5\u8BFB\u53D61\u53F7\u4F4D\u4E3B\u6280\u80FD\u7C7B\u578B\uFF0C\u4E0E\u8BE5\u5361\u81EA\u8EAB\u7C7B\u578B\u65E0\u5173\u3002"
